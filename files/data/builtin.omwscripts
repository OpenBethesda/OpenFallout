# UI framework
MENU,PLAYER: scripts/omw/mwui/init.lua

# Settings framework
MENU: scripts/omw/settings/menu.lua
PLAYER: scripts/omw/settings/player.lua
GLOBAL: scripts/omw/settings/global.lua

# The records of Morrowind that the C++ still reads (attribute and skill names, default GMSTs and the fallback= lines
# of openfallout.cfg). Step 4 of the removal of the Morrowind code (the Interface windows) removes it.
LOAD: scripts/omw/esmfallbacks.lua

