Why this patch is needed
------------------------
OpenSceneGraph builds and installs all its libraries (osgManipulator, osgPresentation, osgTerrain, osgUI, osgVolume,
osgWidget and the others). The engine uses only some of them (USED_OSG_COMPONENTS in the root CMakeLists.txt). The list
variable OSG_SKIP_LIBRARIES (default empty, so nothing changes without it) names library folders that are neither built
nor installed; their serializer plugins (src/osgWrappers/serializers) are skipped with them, because those link the
library. The build script derives the list from the engine's own component list, so the two cannot drift apart.
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index a85c572..f16d0af 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -6,6 +6,10 @@ IF(MSVC80 OR MSVC90)
   OPTION(OSG_MSVC_GENERATE_PLUGINS_AND_WRAPPERS_MANIFESTS "Generate or not manifests files under VS8 for dynamically loaded dlls" ON)
 ENDIF()
 
+# OSG_SKIP_LIBRARIES: a list of library folders (osgTerrain, osgUI, ...) that are neither built nor installed, together
+# with their serializers (osgWrappers/serializers). osg, osgDB and OpenThreads cannot be skipped.
+SET(OSG_SKIP_LIBRARIES "" CACHE STRING "Libraries that are not built")
+
 #the old construct SUBDIRS( was substituted by ADD_SUBDIRECTORY that is to be preferred according on CMake docs.
 FOREACH( mylibfolder
         OpenThreads
@@ -30,7 +34,10 @@ FOREACH( mylibfolder
         osgPlugins
     )
 
-    ADD_SUBDIRECTORY(${mylibfolder})
+    LIST(FIND OSG_SKIP_LIBRARIES ${mylibfolder} OSG_SKIP_INDEX)
+    IF(OSG_SKIP_INDEX EQUAL -1)
+        ADD_SUBDIRECTORY(${mylibfolder})
+    ENDIF()
 
 ENDFOREACH()
 
