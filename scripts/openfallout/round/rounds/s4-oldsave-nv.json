{
  "name": "s4-oldsave-nv",
  "game": "nv",
  "save": "${OPENFALLOUT_ROUND_OLDSAVE_NV}",
  "resolution": [
    1280,
    720
  ],
  "framerate": 30,
  "limit": 900,
  "settings": {
    "Sound": {
      "master volume": "0"
    }
  },
  "env": {
    "OPENFALLOUT_HEADLESS_SOUND": "1"
  },
  "data": [
    "../../autoplay"
  ],
  "extra_args": [
    "--content",
    "FalloutNV.esm",
    "--content",
    "autoplaysaves.omwscripts"
  ],
  "expect_log": [
    "AUTOPLAY\\tdigest\\tloaded\\t.*VCG01=60/r",
    "AUTOPLAY\\tplayer\\tloaded\\t",
    "AUTOPLAY\\tplayer\\tno digest in this save",
    "AUTOPLAY\\tdigest\\tcheck ok",
    "AUTOPLAY\\tsave\\tautoplay-again\\tok\\tdir=[^\\t]*\\tfiles=[^\\t\\n]+",
    "AUTOPLAY\\tintro over\\t"
  ],
  "forbid_log": [
    "unknown GUI (mode|window) '",
    "AUTOPLAY\\tdigest\\tcheck MISMATCH",
    "AUTOPLAY\\tplayer\\t(MISMATCH|error)",
    "AUTOPLAY\\tsave\\tautoplay-again\\t(?!ok\\t)",
    "Failed to save game: ",
    "Ignoring unknown record",
    "AUTOPLAY\\tgate\\t.*\\t(?!ok$)[^\\t]*$",
    "AUTOPLAY\\ttime is up",
    "AUTOPLAY\\tlevel stuck",
    "AUTOPLAY\\tscreens error\\t",
    "AUTOPLAY\\ttalk wait error\\t",
    "AUTOPLAY\\tfire error\\t",
    "AUTOPLAY\\tfire done\\t(time|ammo|error)\\t"
  ],
  "variants": [
    {
      "name": "plain"
    }
  ],
  "expect_exit": 0
}
